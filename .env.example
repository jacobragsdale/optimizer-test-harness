# Copy to .env, then run everything as: uv run --env-file .env harness ...
HARNESS_DB_DSN=local.sqlite
# Oracle (python-oracledb thin mode, no client install):  user/password@host:1521/service
# HARNESS_DB_DSN=qa_harness/secret@qa-db.example.com:1521/QAPDB
# MSSQL (pyodbc):  DRIVER={ODBC Driver 18 for SQL Server};SERVER=qa-sql;DATABASE=Optimizer;UID=u;PWD=p;TrustServerCertificate=yes
# Optional: a SELECT-only account for `harness sql`. Without it discovery uses the read-write DSN and warns.
# HARNESS_DB_RO_DSN=qa_readonly/secret@qa-db.example.com:1521/QAPDB
# Optional: bearer token for the optimizer API.
# HARNESS_API_TOKEN=
