# Copy to .env, then run everything as: uv run --env-file .env harness ...
# Values below run the local demo (docs/setup.md). harness-setup replaces them with the app's QA values.
HARNESS_DB_DSN=demo.sqlite
# Oracle (python-oracledb thin mode, no client install):  user/password@host:1521/service
# HARNESS_DB_DSN=qa_harness/secret@qa-db.example.com:1521/QAPDB
# MSSQL (pyodbc):  DRIVER={ODBC Driver 18 for SQL Server};SERVER=qa-sql;DATABASE=App;UID=u;PWD=p;TrustServerCertificate=yes
# Optional but strongly recommended: a SELECT-only account for `harness sql`. Without it discovery uses the read-write DSN and warns.
# HARNESS_DB_RO_DSN=qa_readonly/secret@qa-db.example.com:1521/QAPDB

# API secrets. harness.toml refers to them as ${NAME} in [api] headers or operation bodies; they are expanded on the wire only.
HARNESS_APP_PASSWORD=demo
# HARNESS_API_TOKEN=
